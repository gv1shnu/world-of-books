# =============================================================================
# Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/worldofbooks?schema=public"

# Redis connection string (for caching and job queue)
REDIS_URL="redis://localhost:6379"

# Frontend origins allowed by CORS (comma-separated, scheme + host only, no path)
FRONTEND_ORIGINS="https://www.vishnugandarapu.in"

# Server-only credential for Google search results (https://serpapi.com/)
# Leave empty to show the manual Google search link instead of automatic extraction.
SERPAPI_API_KEY=""
